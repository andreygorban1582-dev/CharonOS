# ---------------------------------------------------------------------------
# OpenRouter
# ---------------------------------------------------------------------------

# Your OpenRouter API key (required).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (OpenRouter model string).
# Examples:
#   mistralai/mistral-7b-instruct
#   cognitivecomputations/dolphin-mistral-7b
#   openai/gpt-4o
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Optional: shown as the HTTP Referer header when calling OpenRouter.
# OPENROUTER_REFERER=https://github.com/andreygorban1582-dev/CharonOS

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Your Telegram bot token (required for Telegram mode).
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------

# Directory where conversation history and facts are stored.
# Defaults to the "memory/" folder inside the repository.
# MEMORY_DIR=memory

# Maximum number of conversation turns kept in the rolling history window.
# MAX_HISTORY_TURNS=50
