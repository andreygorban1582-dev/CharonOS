# CharonOS Configuration
# Copy this to .env and fill in your values

# Telegram Bot
CHARON_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
CHARON_TELEGRAM_CHAT_ID=your-chat-id

# OpenRouter
CHARON_OPENROUTER_API_KEY=your-openrouter-api-key

# DeepSeek
CHARON_DEEPSEEK_EMAIL=your-deepseek-email
CHARON_DEEPSEEK_PASSWORD=your-deepseek-password

# Additional API keys (comma-separated)
CHARON_EXTRA_API_KEYS=

# Additional emails (comma-separated)
CHARON_EXTRA_EMAILS=

# Agent personality (default: okabe)
CHARON_PERSONALITY=okabe

# Log level
CHARON_LOG_LEVEL=INFO
